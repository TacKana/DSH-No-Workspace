{
	"name": "dsh-no-workspace",
	"version": "0.2.0",
	"description": "Create a private working directory for each new DSH conversation.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/TacKana/DSH-No-Workspace.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": "./dist/host/index.js",
		"./client": "./dist/client/index.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"files": [
		"dist",
		"cordis.patch.yml",
		"locale",
		"icon.svg",
		"README.md"
	],
	"scripts": {
		"build": "npm run build:host && npm run build:client",
		"build:host": "tsc -p tsconfig.host.json",
		"build:client": "node scripts/build-client.mjs",
		"typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json",
		"test": "node test/client/index.test.mjs && node test/client/cordis.integration.test.mjs",
		"test:smoke": "node test/dev-smoke.mjs",
		"test:browser": "node test/dev-smoke.mjs --browser"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-workspace"
			]
		}
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
